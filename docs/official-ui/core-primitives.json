{
    "--gray-50":  "var(--lightningcss-light,#f9f9f9)var(--lightningcss-dark,#131313)",
    "--gray-100":  "var(--lightningcss-light,#ededed)var(--lightningcss-dark,#181818)",
    "--gray-150":  "var(--lightningcss-light,#dfdfdf)var(--lightningcss-dark,#1c1c1c)",
    "--gray-200":  "var(--lightningcss-light,#cdcdcd)var(--lightningcss-dark,#212121)",
    "--gray-300":  "var(--lightningcss-light,#afafaf)var(--lightningcss-dark,#303030)",
    "--gray-400":  "var(--lightningcss-light,#8f8f8f)var(--lightningcss-dark,#414141)",
    "--gray-500":  "#5d5d5d",
    "--gray-600":  "var(--lightningcss-light,#414141)var(--lightningcss-dark,#8f8f8f)",
    "--gray-700":  "var(--lightningcss-light,#303030)var(--lightningcss-dark,#afafaf)",
    "--gray-800":  "var(--lightningcss-light,#212121)var(--lightningcss-dark,#cdcdcd)",
    "--gray-900":  "var(--lightningcss-light,#181818)var(--lightningcss-dark,#ededed)",
    "--gray-950":  "var(--lightningcss-light,#131313)var(--lightningcss-dark,#f3f3f3)",
    "--white":  "#fff",
    "--black":  "#000",
    "--alpha-02":  "var(--alpha-base)",
    "--alpha-05":  "var(--alpha-base)",
    "--alpha-06":  "var(--alpha-base)",
    "--alpha-08":  "var(--alpha-base)",
    "--alpha-12":  "var(--alpha-base)",
    "--alpha-16":  "var(--alpha-base)",
    "--alpha-20":  "var(--alpha-base)",
    "--alpha-25":  "var(--alpha-base)",
    "--alpha-30":  "var(--alpha-base)",
    "--font-ui-family":  "var(--vscode-font-family)",
    "--font-code-family":  "var(--vscode-editor-font-family)",
    "--font-sans-default":  "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "--font-mono-default":  "ui-monospace, \"SFMono-Regular\", \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace",
    "--app-color-background-surface":  "var(--lightningcss-light,var(--gray-fixed-0))var(--lightningcss-dark,var(--gray-fixed-900))",
    "--color-text-emphasis":  "var(--gray-1000)",
    "--color-ring":  "var(--lightningcss-light,var(--blue-500))var(--lightningcss-dark,var(--blue-400))",
    "--color-token-side-bar-background":  "var(--vscode-sideBar-background)",
    "--color-token-foreground":  "var(--vscode-foreground)",
    "--color-token-main-surface-primary":  "var(--app-color-background-surface)",
    "--height-toolbar":  "46px",
    "--height-toolbar-sm":  "36px",
    "--spacing-token-sidebar":  "clamp(240px, var(--codex-sidebar-preferred-width,275px), min(520px, calc(100vw - 320px)))",
    "--radius-lg":  "calc(var(--radius-lg-base) * var(--corner-radius-scale))",
    "--radius-md":  "calc(var(--radius-md-base) * var(--corner-radius-scale))",
    "--radius-sm":  "calc(var(--radius-sm-base) * var(--corner-radius-scale))",
    "--radius-xl":  "calc(var(--radius-xl-base) * var(--corner-radius-scale))",
    "--radius-2xl":  "calc(var(--radius-2xl-base) * var(--corner-radius-scale))",
    "--shadow-100":  "var(--elevation-100-geo) rgb(var(--shadow-color) / var(--shadow-alpha-100))",
    "--shadow-200":  "var(--elevation-200-geo) rgb(var(--shadow-color) / var(--shadow-alpha-200))",
    "--shadow-300":  "var(--elevation-300-geo) rgb(var(--shadow-color) / var(--shadow-alpha-300))"
}
