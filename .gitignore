# Node
node_modules/

# Frontend build output (generated by `npm run build` in frontend/)
frontend/node_modules/
frontend/dist/

# Staged product output (see scripts/stage-dist.ps1 / build-debug.ps1)
dist/
dist-debug/

# The kernel is in-process: there is no engine binary any more. If an exe ever
# reappears under src-tauri/binaries it is a mistake, so keep ignoring it and
# let CI's "Assert no engine binary is bundled" step fail the build.
src-tauri/binaries/

